# NoTrace Mobile — Environment Variables
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the JS bundle.

# ── Proxy Backend URL ────────────────────────────────────────────────────────
# Set this to the address your device can reach the backend on.
#
# Android Emulator (AVD)  → http://10.0.2.2:3000
# Physical device (LAN)   → http://192.168.X.X:3000  (your machine's LAN IP)
# ngrok tunnel            → https://xxxx.ngrok.io
# Cloud deployment        → https://your-api.example.com
#
EXPO_PUBLIC_PROXY_BASE_URL=http://10.0.2.2:3000
